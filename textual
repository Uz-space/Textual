        height: 1;
    }
    #logs-content {
        width: 100%;
        height: 1fr;
        padding: 0 1;
        color: white;
    }
    """

    def __init__(self, conf):
        super().__init__()
        self.conf = conf
        self.bot = None
        self.logs_lines = []

    def compose(self) -> ComposeResult:
        # STATS panel
        with Container(id="stats-box"):
            # Header qatori
            with Horizontal(classes="stats-row"):
                yield Static("[bold #00ffff]ACCOUNT[/]", classes="h-account")
                yield Static("[#555555]│[/]", classes="divider")
                yield Static("[bold #ffff00]BALANCE[/]", classes="h-balance")
                yield Static("[#555555]│[/]", classes="divider")
                yield Static("[bold #ff00ff]NEXT CLAIM IN[/]", classes="h-timer")

            # Gorizontal ajratgich
            yield Static("[#555555]" + "─" * 300 + "[/]", classes="hline")

            # Value qatori
            with Horizontal(classes="stats-row"):
                yield Static("[#00ffff]-[/]", id="val-account", classes="v-account")
                yield Static("[#555555]│[/]", classes="divider")
                yield Static("[#ffff00]0.000000[/]", id="val-balance", classes="v-balance")
                yield Static("[#555555]│[/]", classes="divider")
                yield Static("[#ff00ff]00:00[/]", id="val-timer", classes="v-timer")

        # LOGS panel
        with Container(id="logs-box"):
            yield Static("[bold yellow]📋 LIVE LOGS[/]", id="logs-title")
            yield Static("➜ Initializing...", id="logs-content")

    def on_mount(self) -> None:
        thread = Thread(target=self.run_bot, daemon=True)
        thread.start()
        self.set_interval(0.25, self.refresh_ui)

    def add_log(self, msg, style="white"):
        now = datetime.now().strftime("%H:%M:%S")
        color_map = {
            "white": "white",
            "red": "red",
            "green": "green",
            "yellow": "yellow",
            "cyan": "cyan",
            "magenta": "magenta",
            "bold green": "bold green",
            "bold red": "bold red",
        }
        color = color_map.get(style, "white")
        line = f"[bold grey50]➜ [{now}][/] [{color}]{msg}[/]"
        self.logs_lines.append(line)

        try:
            term_height = self.app.size.height
        except:
            term_height = 24
        max_lines = max(term_height - 8, 3)
        self.logs_lines = self.logs_lines[-max_lines:]

        try:
            logs_widget = self.query_one("#logs-content", Static)
            logs_widget.update("\n".join(self.logs_lines) if self.logs_lines else "➜ Initializing...")
        except:
            pass

    def refresh_ui(self):
        global current_next_claim
        try:
            acc = self.query_one("#val-account", Static)
            bal = self.query_one("#val-balance", Static)
            tmr = self.query_one("#val-timer", Static)

            if self.bot:
                acc.update(f"[#00ffff]{self.bot.email}[/]")
                bal.update(f"[#ffff00]{self.bot.balance}[/]")
            tmr.update(f"[#ff00ff]{current_next_claim}[/]")
        except:
            pass

    def run_bot(self):
        global stop_updater, claim_time_remaining

        def log_cb(msg, style="white"):
            self.app.call_from_thread(self.add_log, msg, style)

        bot = TronPickBot(self.conf['email'], self.conf['password'], self.conf['api_key'])
        self.bot = bot

        success, msg = bot.login(log_cb)
        if not success:
            log_cb(f"LOGIN FAILED! Reason: {msg}", "bold red")
            if "Network Error" in msg:
                log_cb("Tip: Try using a VPN or check your Internet connection.", "yellow")
            if os.path.exists(CONFIG_FILE):
                os.remove(CONFIG_FILE)
            return

        bot.update_info()
        claim_time_remaining = bot.next_claim

        stop_updater = False
        timer_thread = Thread(target=update_timer, daemon=True)
        timer_thread.start()

        while True:
            if claim_time_remaining <= 0:
                bot.update_info()
                claim_time_remaining = bot.next_claim
                if claim_time_remaining <= 0:
                    bot.claim(log_cb)
                    bot.update_info()
                    claim_time_remaining = bot.next_claim
            time.sleep(0.25)


class TronPickApp(App):
    """Asosiy Textual ilova"""

    CSS = """
    Screen {
        background: #000000;
    }
    """

    def on_mount(self) -> None:
        if os.path.exists(CONFIG_FILE):
            try:
                with open(CONFIG_FILE, "r") as f:
                    conf = json.load(f)
                self.push_screen(DashboardScreen(conf))
            except:
                self.push_screen(LoginScreen())
        else:
            self.push_screen(LoginScreen())


if __name__ == "__main__":
    try:
        app = TronPickApp()
        app.run()
    except KeyboardInterrupt:
        stop_updater = True
        sys.exit()
